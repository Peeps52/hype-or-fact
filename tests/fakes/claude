#!/usr/bin/env python3
"""A stand-in for `claude -p ... --output-format stream-json`, for offline tests.

Emits the same event shapes the real CLI does (system/init, assistant
tool_use, user tool_result, result). Behaviour is steered by env vars:

  FAKE_ESCAPE=1    the sandbox probe's outside write succeeds (sandbox broken)
  FAKE_NO_BASH=1   the probe never runs Bash (inconclusive)
  FAKE_USE=1       the candidate skill is invoked when it is available
  FAKE_HANG=1      sleep forever (timeout test)
  FAKE_LIMIT=1     answer like a plan that has hit its usage limit
  FAKE_READ_LEAK=1 the probe's denied read succeeds (sandbox read rules broken)
"""

import json
import os
import re
import sys
import time
from pathlib import Path

args = sys.argv[1:]
if "--help" in args:
    print("Usage: claude [options]\n  --max-budget-usd --output-format --plugin-dir "
          "--mcp-config --strict-mcp-config --settings --no-session-persistence "
          "--allowedTools --permission-mode --model --verbose")
    sys.exit(0)

task = args[args.index("-p") + 1]
cwd = Path.cwd()


def emit(ev):
    print(json.dumps(ev), flush=True)


def val(flag):
    return args[args.index(flag) + 1] if flag in args else None


skills, plugins, mcp = [], [], []
local = cwd / ".claude" / "skills"
if local.is_dir():
    skills += [d.name for d in local.iterdir() if (d / "SKILL.md").exists()]
pdir = val("--plugin-dir")
if pdir:
    manifest = json.loads((Path(pdir) / ".claude-plugin" / "plugin.json").read_text())
    plugins.append({"name": manifest["name"], "path": pdir, "source": "inline"})
    skills += [f"{manifest['name']}:{p.parent.name}" for p in Path(pdir).glob("skills/*/SKILL.md")]
cfg = val("--mcp-config")
if cfg:
    mcp += [{"name": n, "status": "connected"} for n in json.loads(Path(cfg).read_text())["mcpServers"]]

emit({"type": "system", "subtype": "init", "cwd": str(cwd), "skills": skills,
      "slash_commands": [], "plugins": plugins, "mcp_servers": mcp})

if os.environ.get("FAKE_HANG"):
    time.sleep(3600)

if os.environ.get("FAKE_LIMIT"):
    # The real CLI reports this as subtype "success".
    msg = "You've hit your session limit · resets 8:20pm"
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": msg}]}})
    emit({"type": "result", "subtype": "success", "is_error": False, "result": msg,
          "total_cost_usd": 0, "duration_ms": 50, "num_turns": 1, "usage": {}})
    sys.exit(0)

if "sandbox check" in task:
    if not os.environ.get("FAKE_NO_BASH"):
        emit({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "name": "Bash", "input": {"command": "touch ..."}}]}})
        (cwd / "inside.txt").write_text("")
        if os.environ.get("FAKE_ESCAPE"):
            outside = re.search(r"touch (/[^\s;]+)", task).group(1)
            Path(outside).write_text("")
        read = "cat: Operation not permitted"
        if os.environ.get("FAKE_READ_LEAK"):
            read = Path(re.search(r"cat (/[^\s;]+)", task).group(1)).read_text()
        emit({"type": "user", "message": {"content": [
            {"type": "tool_result", "content": "touch: Operation not permitted\n" + read}]}})
    emit({"type": "result", "subtype": "success", "is_error": False, "result": "DONE",
          "total_cost_usd": 0.01, "duration_ms": 100, "num_turns": 2,
          "usage": {"input_tokens": 10, "output_tokens": 5}})
    sys.exit(0)

candidate = next((s for s in skills if "fancy" in s), None)
text = "Plain answer."
if candidate and os.environ.get("FAKE_USE"):
    emit({"type": "assistant", "message": {"content": [
        {"type": "tool_use", "name": "Skill", "input": {"skill": candidate}}]}})
    text = f"I used the {candidate.split(':')[-1]} skill. Fancy answer."
(cwd / "output.txt").write_text(text)
emit({"type": "assistant", "message": {"content": [
    {"type": "tool_use", "name": "Write", "input": {"file_path": "output.txt"}}]}})
emit({"type": "result", "subtype": "success", "is_error": False, "result": text,
      "total_cost_usd": 0.25, "duration_ms": 1500, "num_turns": 3,
      "usage": {"input_tokens": 100, "output_tokens": 50,
                "cache_read_input_tokens": 1000}})
